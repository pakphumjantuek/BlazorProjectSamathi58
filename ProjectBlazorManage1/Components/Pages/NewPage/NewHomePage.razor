@page "/NewsPage"

@inject NewsService NewsService
@inject NavigationManager NavigationManager

<PageTitle>ข่าวประชาสัมพันธ์</PageTitle>

<div class="container my-5">
    <!-- Header Section with Hero Banner -->
    <div class="bg-light rounded-4 shadow-sm p-4 mb-5">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="display-5 fw-bold text-success mb-3">ข่าวประชาสัมพันธ์</h1>
                <p class="lead text-muted">อัพเดทข่าวสารและกิจกรรมล่าสุดจากเรา</p>
            </div>
            <div class="col-lg-4 text-end d-none d-lg-block">
                <i class="bi bi-newspaper text-success" style="font-size: 5rem;"></i>
            </div>
        </div>
    </div>

    <!-- Loading State -->
    @if (isLoading)
    {
        <div class="text-center my-5 py-5">
            <div class="spinner-border text-success" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">กำลังโหลดข้อมูล...</span>
            </div>
            <p class="mt-3 text-muted">กำลังโหลดข้อมูลข่าว...</p>
        </div>
    }
    else
    {
    <div class="mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center">
            <p class="mb-0 text-muted">แสดงข่าวทั้งหมด <span class="fw-bold">@allNews.Count</span> รายการ</p>
        </div>
    </div>

    <!-- News Cards Section -->
    <div class="row g-4">
        @foreach (var news in pagedNewsList)
        {
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 border-0 shadow-sm hover-card overflow-hidden">
                    <div class="position-relative news-image-container">
                        @if (!string.IsNullOrEmpty(news.Images))
                        {
                            var firstImage = news.Images.Split(';').FirstOrDefault();
                            if (!string.IsNullOrEmpty(firstImage))
                            {
                                <img src="@firstImage"
                                     class="card-img-top"
                                     style="height: 220px; object-fit: cover; transition: transform 0.3s ease;"
                                     alt="ข่าว @news.Title"
                                     onerror="this.onerror=null; this.src='/images/placeholder.png';" />
                            }
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center" style="height: 220px;">
                                <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                            </div>
                        }
                        <div class="news-date-badge">
                            <span class="date-day">@news.DateStart.Day</span>
                            <span class="date-month">@news.DateStart.ToString("MMM", new System.Globalization.CultureInfo("th-TH"))</span>
                        </div>
                    </div>

                    <div class="card-body d-flex flex-column p-4">
                        <h5 class="card-title fw-bold mb-3 text-truncate-2">@news.Title</h5>
                        <div class="text-muted mb-3 d-flex align-items-center small">
                            <i class="bi bi-calendar-event me-2"></i>
                            @news.DateStart.ToString("d MMMM yyyy", new System.Globalization.CultureInfo("th-TH"))
                        </div>
                        <div class="card-text mb-4 news-content-preview">
                            @((MarkupString)news.News_Content)
                        </div>
                        <div class="mt-auto text-end">
                            <button class="btn btn-success px-4 rounded-pill" @onclick="() => GoToDetails(news.News_Id)">
                                <i class="bi bi-book me-2"></i>อ่านเพิ่มเติม
                            </button>
                        </div>
                    </div>
                </div>
            </div>

        }
    </div>


    <!-- Enhanced Pagination -->
    @if (totalPages > 1)
    {
        <nav class="mt-5">
            <ul class="pagination pagination-lg justify-content-center flex-wrap gap-1">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a href="javascript:void(0);" class="page-link rounded-pill shadow-sm border-0 text-success px-3 py-2"
                       @onclick="PreviousPage" @onclick:preventDefault>
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>

                @{
                    int startPage = Math.Max(1, currentPage - 2);
                    int endPage = Math.Min(totalPages, startPage + 4);

                    if (endPage - startPage < 4 && totalPages > 5)
                    {
                        startPage = Math.Max(1, endPage - 4);
                    }

                    if (startPage > 1)
                    {
                        <li class="page-item">
                            <a href="javascript:void(0);" class="page-link rounded-pill border-0 shadow-sm px-3 py-2"
                               @onclick="() => ChangePage(1)" @onclick:preventDefault>1</a>
                        </li>
                        if (startPage > 2)
                        {
                            <li class="page-item disabled">
                                <span class="page-link border-0 bg-transparent shadow-none">...</span>
                            </li>
                        }
                    }

                    for (int i = startPage; i <= endPage; i++)
                    {
                        var pageNumber = i;
                        <li class="page-item @(currentPage == pageNumber ? "active" : "")">
                            <a href="javascript:void(0);"
                               class="page-link rounded-pill border-0 shadow-sm px-3 py-2 @(currentPage == pageNumber ? "bg-success text-white" : "text-success")"
                               @onclick="() => ChangePage(pageNumber)"
                            @onclick:preventDefault>@pageNumber</a>
                        </li>
                    }

                    if (endPage < totalPages)
                    {
                        if (endPage < totalPages - 1)
                        {
                            <li class="page-item disabled">
                                <span class="page-link border-0 bg-transparent shadow-none">...</span>
                            </li>
                        }
                        <li class="page-item">
                            <a href="javascript:void(0);" class="page-link rounded-pill border-0 shadow-sm px-3 py-2"
                               @onclick="() => ChangePage(totalPages)" @onclick:preventDefault>@totalPages</a>
                        </li>
                    }
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a href="javascript:void(0);" class="page-link rounded-pill shadow-sm border-0 text-success px-3 py-2"
                       @onclick="NextPage" @onclick:preventDefault>
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }

}
</div>



@code {
    private List<News> allNews = new();
    private List<News> pagedNewsList = new();
    private int currentPage = 1;
    private int pageSize = 6;
    private int totalPages = 1;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        allNews = await NewsService.GetAllNews() ?? new List<News>();

        if (allNews.Any())
        {
            allNews = allNews.OrderByDescending(n => n.DateStart).ToList();
            totalPages = (int)Math.Ceiling(allNews.Count / (double)pageSize);
            LoadCurrentPage();
        }
        else
        {
            pagedNewsList = new List<News>();
            totalPages = 1;
        }

        isLoading = false;
    }


    private void LoadCurrentPage()
    {
        // ป้องกัน currentPage ผิดช่วง
        if (currentPage < 1) currentPage = 1;
        if (currentPage > totalPages && totalPages > 0) currentPage = totalPages;

        pagedNewsList = allNews
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();

        StateHasChanged(); // เพิ่มการเรียก StateHasChanged เพื่ออัปเดต UI
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            LoadCurrentPage();
        }
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            LoadCurrentPage();
        }
    }

    private void NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            LoadCurrentPage();
        }
    }

    private void GoToDetails(int newsId)
    {
        NavigationManager.NavigateTo($"/News/NewsDetails/{newsId}");
    }
}


<style>
    /* Custom styles for the news page */
    .hover-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .hover-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }

            .hover-card:hover img {
                transform: scale(1.05);
            }

    .news-image-container {
        overflow: hidden;
        position: relative;
    }

    .news-date-badge {
        position: absolute;
        bottom: 0;
        right: 0;
        background: rgba(25, 135, 84, 0.9);
        color: white;
        padding: 5px 15px;
        display: flex;
        flex-direction: column;
        align-items: center;
        border-top-left-radius: 8px;
    }

    .date-day {
        font-size: 1.5rem;
        font-weight: bold;
        line-height: 1;
    }

    .date-month {
        font-size: 0.8rem;
        text-transform: uppercase;
    }

    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        height: 3rem;
    }

    .news-content-preview {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        height: 4.5rem;
        color: #6c757d;
    }

        /* Make sure images in news content preview are properly sized */
        .news-content-preview img {
            display: none;
        }
</style>