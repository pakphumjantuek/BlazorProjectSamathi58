@page "/ClassStudie"
@inject ClassStudieService ClassStudiedService
@inject BranchService branchService
@inject IJSRuntime JSRuntime

<Modals @ref="classStudiedModal"
		Title="ระบบจัดการข้อมูลรุ่นที่เรียน"
		IsVisible="showModal"
		OnConfirm="HandleValidSubmit"
		OnClose="CloseModal">
	<ChildContent>
		<EditForm id="modalForm" Model="@currentClassStudied" OnValidSubmit="@HandleValidSubmit">
			<DataAnnotationsValidator />
			<ValidationSummary />

			@if (currentClassStudied != null)
			{
				<div class="form-group mb-3">
					<label>รหัสรุ่น</label>
					<InputNumber class="form-control" @bind-Value="currentClassStudied.Id" min="1" />
					<ValidationMessage For="@(() => currentClassStudied.Id)" />
				</div>
				<div class="form-group mb-3">
					<label>ชื่อรุ่น</label>
					<InputText class="form-control" @bind-Value="currentClassStudied.ClassName" placeholder="โปรดกรอกชื่อรุ่น" />
					<ValidationMessage For="@(() => currentClassStudied.ClassName)" />
				</div>
				<div class="form-floating py-3">
					<InputSelect @bind-Value="currentClassStudied.Branch_Id" class="form-select" id="branch">
						<option value="0" disabled selected>--โปรดเลือกสาขา--</option>
						@foreach (var b in _branch)
						{
							if (b.Status == true)
							{
								<option value="@b.Branch_Id">@b.Branch_Id @b.Branch_Name</option>
							}
						}
					</InputSelect>
					<label for="branch">สาขา</label>
					<ValidationMessage For="@(() => currentClassStudied.Branch_Id)" />
				</div>
				<div class="form-group mb-3">
					<label>ภาคเรียน</label>
					<InputText class="form-control" @bind-Value="currentClassStudied.termClass" placeholder="โปรดกรอกภาคเรียน" />
					<ValidationMessage For="@(() => currentClassStudied.termClass)" />
				</div>
				<div class="form-group mb-3">
					<label>วันที่เริมเรียน</label>
					<InputDate class="form-control" @bind-Value="currentClassStudied.StartDate" />
					<ValidationMessage For="@(() => currentClassStudied.StartDate)" />
				</div>
				<div class="form-group mb-3">
					<label>วันที่สิ้นสุดการเรียน</label>
					<InputDate class="form-control" @bind-Value="currentClassStudied.EndDate" />
					<ValidationMessage For="@(() => currentClassStudied.EndDate)" />
				</div>

			}
		</EditForm>
	</ChildContent>
</Modals>


@if (IsProcessing)
{
	<div class="position-absolute w-75 h-75 d-flex flex-column align-items-center bg-white justify-content-center">
		<div class="spinner">
			<div class="rect1"></div>
			<div class="rect2"></div>
			<div class="rect3"></div>
			<div class="rect4"></div>
			<div class="rect5"></div>
		</div>
	</div>
}
else
{
	<div class="card shadow border-0 mt-4">
		<div class="card-header bg-black bg-gradient ml-0 py-3">
			<div class="row">
				<div class="col-12 text-center">
					<h2 class="text-white py-2">ระบบจัดการข้อมูลรุ่นที่เรียน</h2>
				</div>
			</div>
		</div>
		<div class="card-body p-4">
			<MudDataGrid T="ClassStudied"
						 Items="@FilteredClassstudieList"
						 SortMode="SortMode.Multiple"
						 Filterable="true"
						 Hover="true"
						 Elevation="2"
						 Dense="true"
						 Bordered="true"
						 Striped="true"
						 RowClick="@(args => ShowEditModal(args.Item))"
						 Class="custom-datagrid mt-4">

				<ToolBarContent>
					<MudText Typo="Typo.h6" Color="Color.Primary" Class="font-weight-bold">ระบบจัดการข้อมูลรุ่นที่เรียน</MudText>
					<MudSpacer />
					 <div style="display: flex; align-items: center; gap: 12px;">
					<MudTextField @bind-Value="searchString"
								  Placeholder="ค้นหา..."
								  Variant="Variant.Outlined"
								  Size="Size.Small"
								  Adornment="Adornment.Start"
								  AdornmentIcon="@Icons.Material.Filled.Search"
								  Class="mr-2"
								  Immediate="true"
								  DebounceInterval="3000"
								  Style="width: 300px; font-size: 0.875rem;"
								  Margin="Margin.Dense" />
					<MudButton Variant="Variant.Filled"
							   Color="Color.Secondary"
							   StartIcon="@Icons.Material.Filled.Add"
							   OnClick="ShowAddModal"
							   Size="Size.Medium">
						เพิ่มข้อมูลรุ่นที่เรียน
					</MudButton>			
					 </div>
				</ToolBarContent>

				<Columns>
					<PropertyColumn Property="x => x.Id"
									Title="รหัสรุ่น"
									Filterable="true"
									Sortable="true"
									CellStyle="font-size: 14px;" />

					<TemplateColumn Title="วันที่เริ่มเรียน"
									Filterable="false"
									Sortable="true">
						<CellTemplate>
							@context.Item.StartDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("th-TH"))
						</CellTemplate>
					</TemplateColumn>

					<TemplateColumn Title="วันที่สิ้นสุดการเรียน"
									Filterable="false"
									Sortable="true">
						<CellTemplate>
							@context.Item.EndDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("th-TH"))
						</CellTemplate>
					</TemplateColumn>

					<TemplateColumn Title="สถานะ"
									CellClass="status-column"
									Sortable="false">
						<CellTemplate>
							<div @onclick:stopPropagation>
								<MudSwitch Value="@context.Item.Status"
										   ValueChanged="@(async (bool value) => await ToggleStatus(context.Item))"
										   ThumbIcon="@(context.Item.Status ? Icons.Material.Filled.Done : Icons.Material.Filled.Close)"
										   ThumbIconColor="@(context.Item.Status ? Color.Success : Color.Error)"
										   Disabled="@IsProcessing"
										   Class="custom-switch" />
							</div>
						</CellTemplate>
					</TemplateColumn>

					<TemplateColumn Title="ตารางเรียน"
									Sortable="false"
									CellStyle="text-align:center;">
						<CellTemplate>
							<div @onclick:stopPropagation>

								<MudButton Variant="Variant.Outlined"
										   Color="Color.Primary"
										   Size="Size.Small"
										   Href="@($"/ClassStudie/Timetable/{context.Item.Id}")">
									ตารางเรียน
								</MudButton>
							</div>
						</CellTemplate>
					</TemplateColumn>

					<TemplateColumn Title="การจัดการ"
									Sortable="false"
									CellClass="action-column">
						<CellTemplate>
							<MudStack Row="true" Spacing="2">
								<MudButton Variant="Variant.Outlined"
										   Color="Color.Primary"
										   Size="Size.Small"
										   StartIcon="@Icons.Material.Filled.Edit"
										   OnClick="@(() => ShowEditModal(context.Item))">
									แก้ไข
								</MudButton>
								<MudButton Variant="Variant.Outlined"
										   Color="Color.Error"
										   Size="Size.Small"
										   StartIcon="@Icons.Material.Filled.Delete"
										   OnClick="@(() => Delete(context.Item.Id))">
									ลบ
								</MudButton>
							</MudStack>
						</CellTemplate>
					</TemplateColumn>
				</Columns>

				<PagerContent>
					<MudDataGridPager T="ClassStudied" />
				</PagerContent>
			</MudDataGrid>

		</div>
	</div>

}


@code {
	private List<ClassStudied> ClassStudiesList = new();
	private ClassStudied classStudied = new();
	private IEnumerable<Branch> _branch = new List<Branch>();
	private bool IsProcessing { get; set; } = true;

	private Modals classStudiedModal;
	private bool showModal = false;
	private ClassStudied currentClassStudied = new ClassStudied { Id = 1 };
	private bool isEditMode = false;

	private string searchString = string.Empty;
	private IEnumerable<ClassStudied> FilteredClassstudieList => ClassStudiesList
			.Where(x => string.IsNullOrWhiteSpace(searchString) ||
					x.Id.ToString().Contains(searchString))
					.OrderBy(p => p.Branch_Id);

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await LoadClassstudies();
			IsProcessing = false;
			StateHasChanged();
		}
	}

	private async Task LoadClassstudies()
	{
		ClassStudiesList = await ClassStudiedService.GetClassStudies();
		_branch = await branchService.GetBranches();

	}

	private void ShowAddModal()
	{
		currentClassStudied = new ClassStudied();
		isEditMode = false;
		showModal = true;
		StateHasChanged();
	}

	private void ShowEditModal(ClassStudied classStudied)
	{
		currentClassStudied = new ClassStudied
			{
				Id = classStudied.Id,
				StartDate = classStudied.StartDate,
				EndDate = classStudied.EndDate,
				Status = classStudied.Status,
				ClassName = classStudied.ClassName,
				termClass = classStudied.termClass,
				Branch_Id = classStudied.Branch_Id
			};
		isEditMode = true;
		showModal = true;
		StateHasChanged();
	}

	private void CloseModal()
	{
		showModal = false;
		StateHasChanged();
	}

	public async Task Delete(int id)
	{
		bool confirmDelete = await JSRuntime.InvokeAsync<bool>("ShowSwal", "success", "คุณแน่ใจที่จะลบหรือไม่?");

		if (confirmDelete)
		{
			await ClassStudiedService.DeleteClassStudy(id);

			await JSRuntime.InvokeVoidAsync("showToastr", "success", "ลบสำเร็จ");
		}
		await LoadClassstudies();
	}

	private async Task HandleValidSubmit()
	{
		try
		{
			IsProcessing = true;
			StateHasChanged();

			if (isEditMode)
			{
				await ClassStudiedService.UpdateClassStudy(currentClassStudied);
				await JSRuntime.InvokeAsync<bool>("ShowSwal", "test", "อัพเดทสำเร็จ");
			}
			else
			{
				await ClassStudiedService.AddClassStudy(currentClassStudied);
				await JSRuntime.InvokeAsync<bool>("ShowSwal", "test", "เพิ่มสำเร็จ");
			}

			await LoadClassstudies();
			showModal = false;
		}
		catch (Exception ex)
		{
			await JSRuntime.InvokeVoidAsync("showToastr", "error", $"เกิดข้อผิดพลาด: {ex.Message}");
		}
		finally
		{
			IsProcessing = false;
			StateHasChanged();
		}
	}

	private async Task ToggleStatus(ClassStudied classStudied)
	{
		IsProcessing = true;
		StateHasChanged();
		classStudied.Status = !classStudied.Status;
		await ClassStudiedService.UpdateClassStudy(classStudied);
		await LoadClassstudies();
		if (classStudied.Status)
		{
			await JSRuntime.InvokeVoidAsync("showToastr", "success", "เปิดสถานะสำเร็จ");
		}
		else
		{
			await JSRuntime.InvokeVoidAsync("showToastr", "success", "ปิดสถานะสำเร็จ");
		}
		IsProcessing = false;
	}

}
