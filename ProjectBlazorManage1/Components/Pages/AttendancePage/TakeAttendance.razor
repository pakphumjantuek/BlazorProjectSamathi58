@page "/attendance/take/{classId:int}/{learningPlanId:int}"
@inject AttendanceService _attendanceService

@if (isLoading)
{
    <div class="d-flex justify-content-center align-items-center my-5">
        <div class="spinner-border text-primary me-3" role="status">
            <span class="visually-hidden">กำลังโหลดข้อมูล...</span>
        </div>
        <strong class="text-secondary">กำลังโหลดข้อมูล...</strong>
    </div>
}
else
{
    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-header bg-primary bg-gradient text-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h3 class="mb-0 fs-5">
                    <i class="bi bi-clipboard-check me-2"></i> เช็คชื่อนักเรียน - @attendanceViewModel.LearningPlanName
                </h3>
                <span class="badge bg-light text-primary rounded-pill px-3 py-2">
                    <i class="bi bi-calendar-event me-1"></i>@DateTime.Now.ToString("dd/MM/yyyy")
                </span>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="text-center">
                            <th>รหัส</th>
                            <th class="text-start">ชื่อ</th>
                            <th>สถานะ</th>
                            <th>เรียนเสริม</th>
                            <th class="text-start">หมายเหตุ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in attendanceViewModel.AttendanceRecords)
                        {
                            var student = attendanceViewModel.Students.First(s => s.Id == record.StudentId);
                            <tr @key="record.StudentId">
                                <td class="text-center fw-bold">@student.Id</td>
                                <td class="text-start">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar bg-light text-primary rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                            <strong>@student.FirstName[0]</strong>
                                        </div>
                                        <span>@student.FirstName @student.LastName</span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <select class="form-select form-select-sm" @bind="record.StudiedType">
                                        @foreach (var type in Enum.GetValues<StudiedType>())
                                        {
                                            <option value="@type">@type.ToString()</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center align-items-center" style="height: 100%;">
                                        <MudCheckBox @bind-Value="record.Extraclass"></MudCheckBox>
                                    </div>
                                </td>
                                <td>
                                    <input type="text" class="form-control form-control-sm" @bind="record.Remarks" placeholder="เพิ่มหมายเหตุ..." />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-footer bg-white py-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div class="text-muted mb-2 mb-md-0">
                    จำนวนนักเรียนทั้งหมด: <span class="fw-bold">@attendanceViewModel.AttendanceRecords.Count()</span> คน
                </div>
                <div class="d-flex gap-2">
                    <a class="btn btn-outline-secondary px-4" href="/attendance/menu/@classId">
                        <i class="bi bi-arrow-left-circle-fill me-2"></i> กลับ
                    </a>
                    <button class="btn btn-primary px-4" @onclick="SaveAttendance">
                        <i class="bi bi-save me-2"></i> บันทึกข้อมูล
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
        </div>
    }
}

@code {
    [Parameter] public int classId { get; set; }
    [Parameter] public int learningPlanId { get; set; }

    private AttendanceViewModel attendanceViewModel = new();
    private bool isLoading = true;
    private string successMessage;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        attendanceViewModel = await _attendanceService.LoadAttendanceViewModelAsync(classId, learningPlanId);
        isLoading = false;
    }

    private async Task SaveAttendance()
    {
        await _attendanceService.SaveAttendanceAsync(attendanceViewModel);
        successMessage = "✅ บันทึกการเข้าเรียนเรียบร้อยแล้ว";
    }
}
