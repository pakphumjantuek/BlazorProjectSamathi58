@page "/Teacher"
@inject IJSRuntime JSRuntime
@inject TeacherService teacherService
@inject InitialService initialService
@inject JobPositionService jobPositionService
@inject BranchService branchService
@inject DhammaCourseService dhammaCourseService
@inject IWebHostEnvironment _webHostEnvironment

<div class="card shadow border-0 mt-4">
	<div class="card-header bg-black bg-gradient ml-0 py-3">
		<div class="row">
			<div class="col-12 text-center">
				<h2 class="text-white py-2">ระบบจัดการข้อมูลผู้สอน</h2>
			</div>
		</div>
	</div>
	<div class="card-body p-4">

		<div class="row pb-3">
			<div class="col-12 text-end">
				<button class="btn btn-lg btn-secondary" style="width:250px;" @onclick="() => ShowAddModal()">
					<i class="bi bi-plus-square"></i> เพิ่มข้อมูลผู้สอน
				</button>
			</div>
		</div>

		<!-- ตารางแสดงผู้สอนทั้งหมด -->
		<table class="table table-bordered">
			<thead>
				<tr>
					<th>ชื่อ-นามสกุล</th>
					<th>เบอร์โทรศัพท์</th>
					<th>รายละเอียด</th>
					<th>การจัดการ</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var t in teachersList)
				{
					<tr>
						<td>@t.Teacher_Name @t.Teacher_LastName</td>
						<td>@t.Phone_Number</td>
						<td>
							<a class="btn btn-sm btn-primary" href="@($"Teacher/Teacher_Detail/{t.Teacher_Id}")">รายละเอียด</a>
						</td>
						<td>
							<button class="btn btn-sm btn-warning" @onclick="() => ShowEditModal(t)">แก้ไข</button>
							<button class="btn btn-sm btn-danger" @onclick="() => DeleteTeacher(t.Teacher_Id)">ลบ</button>
						</td>
					</tr>
				}
			</tbody>
		</table>

		<hr class="my-5" />

		<!-- ส่วนเลือกหลักสูตร -->
		<div class="row mb-4">
			<div class="col-md-6">
				<label for="courseSelect">เลือกหลักสูตรที่ต้องการดูอาจารย์ที่เคยเรียน:</label>
				<InputSelect id="courseSelect" class="form-select" @bind-Value="selectedCourseId" @onchange="OnCourseChanged">
					<option value="0">-- เลือกหลักสูตร --</option>
					@foreach (var course in courseList)
					{
						<option value="@course.Id">@course.Name</option>
					}
				</InputSelect>
			</div>
		</div>

		@if (selectedCourseId > 0 && filteredTeachers?.Any() == true)
		{
			<h5 class="mt-4 text-primary">
				รายชื่ออาจารย์ที่เคยเรียนหลักสูตร:
				<strong>@courseList.FirstOrDefault(c => c.Id == selectedCourseId)?.Name</strong>
			</h5>

			<table class="table table-bordered">
				<thead>
					<tr>
						<th>ชื่อ - นามสกุล</th>
						<th>เบอร์โทร</th>
						<th>ตำแหน่ง</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var course in courseEnrollments)
					{
						<tr>
							<td>@course.Teacher.Teacher_Name @course.Teacher.Teacher_LastName</td>
							<td>@course.Teacher.Phone_Number</td>
							<td>@course.generation</td>
						</tr>
					}
				</tbody>
			</table>
		}
		else if (selectedCourseId > 0)
		{
			<p class="text-danger">ไม่พบอาจารย์ที่เคยเรียนในหลักสูตรนี้</p>
		}
	</div>
</div>

@code {
	private List<Teacher> teachersList = new();
	private List<CourseName> courseList = new();
	private List<Teacher> filteredTeachers = new();

	private int selectedCourseId = 0;

	private IEnumerable<Initial> _initial = new List<Initial>();
	private IEnumerable<Branch> _branch = new List<Branch>();
	private IEnumerable<JobPosition> _jobps = new List<JobPosition>();

	private Teacher currentTeacher = new();
	private bool isEditMode = false;

	private List<DhammaCourse> courseEnrollments = new();


	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await LoadTeacher();
			await LoadCourseData();
			StateHasChanged();
		}
	}

	private async Task LoadTeacher()
	{
		teachersList = await teacherService.GetAllTeachers();
		_initial = await initialService.GetInitials();
		_branch = await branchService.GetBranches();
		_jobps = await jobPositionService.GetJobPS();
	}

	private async Task LoadCourseData()
	{
		courseList = await teacherService.GetAllCourseNames();
	}

	private async Task OnCourseChanged(ChangeEventArgs e)
	{
		if (int.TryParse(e.Value?.ToString(), out int id))
		{
			selectedCourseId = id;

			courseEnrollments = await dhammaCourseService.GetDhammaCoursesByCourseId(selectedCourseId);
			StateHasChanged();	
		}
	}

	private void ShowAddModal()
	{
		currentTeacher = new Teacher();
		isEditMode = false;
		// logic สำหรับแสดง Modal เพิ่ม
	}

	private void ShowEditModal(Teacher teacher)
	{
		currentTeacher = teacher;
		isEditMode = true;
		// logic สำหรับแสดง Modal แก้ไข
	}

	private async Task DeleteTeacher(int id)
	{
		bool confirmDelete = await JSRuntime.InvokeAsync<bool>("ShowSwal", "warning", "คุณแน่ใจหรือไม่ที่จะลบ?");
		if (confirmDelete)
		{
			await teacherService.DeleteTeacher(id);
			await LoadTeacher();
			await JSRuntime.InvokeVoidAsync("showToastr", "success", "ลบสำเร็จ");
		}
	}
}
