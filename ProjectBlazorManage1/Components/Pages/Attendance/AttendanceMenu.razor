@page "/attendance/menu/{ClassId:int}"
@inject ApplicationDbContext _context
@using Microsoft.EntityFrameworkCore

<h3 class="text-center">ระบบบันทึกการเข้าเรียน</h3>
<h4 class="text-center">หลักสูตรครูสมาธิ รุ่นที่ @ClassNumber</h4>

@if (IsProcessing)
{
    <div class="position-absolute w-75 h-75 d-flex flex-column align-items-center bg-white justify-content-center">
        <div class="spinner">
            <div class="rect1"></div>
            <div class="rect2"></div>
            <div class="rect3"></div>
            <div class="rect4"></div>
            <div class="rect5"></div>
        </div>
    </div>
}
else
{
    <div class="row mb-3">
        <div class="col-md-6 offset-md-3">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">เลือกรายการ</h5>
                </div>
                <div class="card-body">
                    <div class="list-group">
                        <a class="list-group-item list-group-item-action"
                           href="@($"/attendance/report/{ClassId}")">
                            <i class="bi bi-bar-chart-fill"></i> รายงานการเข้าเรียนทั้งหมด
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">รายวิชา</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover">
                    <thead>
                        <tr>
                            <th class="text-center">วันที่</th>
                            <th class="text-center">เวลา</th>
                            <th class="text-center">รายวิชา</th>
                            <th class="text-center">เทปที่</th>
                            <th class="text-center">ผู้บรรยาย</th>
                            <th class="text-center">การจัดการ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var plan in LearningPlans)
                        {
                            <tr>
                                <td class="text-center">@plan.Date?.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("th-TH"))</td>
                                <td class="text-center">@plan.Time</td>
                                <td>@plan.Name</td>
                                <td class="text-center">@plan.Tape</td>
                                <td class="text-center">@($"{plan.teacher?.Teacher_Name} {plan.teacher?.Teacher_LastName}")</td>
                                <td class="text-center">
                                    <a class="btn btn-sm btn-primary"
                                       href="@($"/attendance/take/{ClassId}/{plan.Id}")">
                                        <i class="bi bi-pencil-square"></i> บันทึกการเข้าเรียน
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="text-center mt-3">
        <a class="btn btn-secondary" href="@($"/class-details/{ClassId}")">
            <i class="bi bi-arrow-left"></i> กลับ
        </a>
    </div>  
}

@code {
    [Parameter] public int ClassId { get; set; }
    public int ClassNumber { get; set; }
    public List<LearningPlan> LearningPlans { get; set; } = new();
    private bool IsProcessing = true;

    protected override async Task OnInitializedAsync()
    {
        var classDetails = await _context.ClassStudieds.FirstOrDefaultAsync(c => c.Id == ClassId);
        if (classDetails != null)
        {
            ClassNumber = classDetails.Id;

            LearningPlans = await _context.LearningPlans
            .Include(p => p.teacher)
                .Where(l => l.ClassStudiedId == ClassId)
                .OrderBy(l => l.Date)
                .ToListAsync();
        }

        IsProcessing = false;
    }
}
