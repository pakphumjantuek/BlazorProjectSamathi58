@page "/attendance/take/{classId:int}/{learningPlanId:int}"
@inject ApplicationDbContext _context
@using ProjectBlazorManage1.Model.Dtos
@using Microsoft.EntityFrameworkCore


@if (isLoading)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">กำลังโหลดข้อมูล...</span>
        </div>
        <span class="ms-3">กำลังโหลดข้อมูล...</span>
    </div>
}
else
{
    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-header bg-primary bg-gradient text-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h3 class="mb-0 fs-4"><i class="bi bi-clipboard-check me-2"></i>เช็คชื่อนักเรียน - @attendanceViewModel.LearningPlanName</h3>
                <span class="badge bg-light text-primary rounded-pill">@DateTime.Now.ToString("dd/MM/yyyy")</span>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-3">รหัส</th>
                            <th>ชื่อ</th>
                            <th>สถานะ</th>
                            <th>หมายเหตุ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in attendanceViewModel.AttendanceRecords)
                        {
                            var student = attendanceViewModel.Students.First(s => s.Id == record.StudentId);
                            <tr>
                                <td class="px-3">@student.Id</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar bg-light text-primary rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                            <span>@student.FirstName[0]</span>
                                        </div>
                                        <div>@student.FirstName @student.LastName</div>
                                    </div>
                                </td>
                                <td>
                                    <select class="form-select form-select-sm" @bind="record.StudiedType">
                                        @foreach (var type in Enum.GetValues<StudiedType>())
                                        {
                                            <option value="@type">@type.ToString()</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input type="text" class="form-control form-control-sm" @bind="record.Remarks" placeholder="เพิ่มหมายเหตุ..." />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted">
                        จำนวนนักเรียนทั้งหมด: <span class="fw-bold">@attendanceViewModel.AttendanceRecords.Count()</span> คน
                    </span>
                </div>
                <div class="d-flex gap-2">
                    <a class="btn btn-outline-secondary px-4" href="/attendance/menu/@classId">
                        <i class="bi bi-arrow-left-circle-fill me-2"></i>กลับ
                    </a>
                    <button class="btn btn-primary px-4" @onclick="SaveAttendance">
                        <i class="bi bi-save me-2"></i>บันทึกข้อมูล
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
        </div>
    }
}



@code {
    [Parameter] public int classId { get; set; }
    [Parameter] public int learningPlanId { get; set; }

    private AttendanceViewModel attendanceViewModel = new();
    private bool isLoading = true;
    private string successMessage;

    protected override async Task OnInitializedAsync()
    {
        var learningPlan = await _context.LearningPlans
            .Include(l => l.ClassStudied)
            .FirstOrDefaultAsync(l => l.Id == learningPlanId && l.ClassStudiedId == classId);

        if (learningPlan == null)
        {
            // handle not found
            return;
        }

        var students = await _context.students
            .Where(s => s.ClassStudie_Id == classId)
            .OrderBy(s => s.Id)
            .ToListAsync();

        var existingAttendance = await _context.Attendances
            .Where(a => a.LearningPlanId == learningPlanId)
            .ToDictionaryAsync(a => a.StudentId, a => a);

        attendanceViewModel = new AttendanceViewModel
            {
                ClassId = classId,
                LearningPlanId = learningPlanId,
                LearningPlanName = learningPlan.Name,
                ClassNumber = learningPlan.ClassStudied.Id,
                Date = learningPlan.Date ?? DateTime.Now,
                Students = students,
                ExistingAttendance = existingAttendance,
                AttendanceRecords = students.Select(s => new Attendance
                {
                    StudentId = s.Id,
                    StudiedType = existingAttendance.ContainsKey(s.Id) ? existingAttendance[s.Id].StudiedType : StudiedType.มาเรียน,
                    Remarks = existingAttendance.ContainsKey(s.Id) ? existingAttendance[s.Id].Remarks : ""
                }).ToList()
            };

        isLoading = false;
    }

    private async Task SaveAttendance()
    {
        foreach (var attendance in attendanceViewModel.AttendanceRecords)
        {
            var existingRecord = await _context.Attendances
                .FirstOrDefaultAsync(a => a.StudentId == attendance.StudentId && a.LearningPlanId == attendanceViewModel.LearningPlanId);

            if (existingRecord != null)
            {
                existingRecord.StudiedType = attendance.StudiedType;
                existingRecord.Remarks = attendance.Remarks;
                _context.Update(existingRecord);
            }
            else
            {
                _context.Attendances.Add(new Attendance
                    {
                        StudentId = attendance.StudentId,
                        LearningPlanId = attendanceViewModel.LearningPlanId,
                        CheckInTime = DateTime.Now,
                        StudiedType = attendance.StudiedType,
                        Remarks = attendance.Remarks,
                    });
            }
        }

        await _context.SaveChangesAsync();
        successMessage = "บันทึกการเข้าเรียนเรียบร้อยแล้ว";
    }
}
