@page "/Initial"
@inject InitialService InitialService
@inject IJSRuntime JSRuntime


<Modals @ref="initialModal"
		Title="ระบบจัดการข้อมูลคำนำหน้าชื่อ"
		IsVisible="showModal"
		OnConfirm="HandleValidSubmit"
		OnClose="CloseModal">

	<ChildContent>
		<EditForm Model="@currentInitial" OnValidSubmit="@HandleValidSubmit">
			<DataAnnotationsValidator />
			<ValidationSummary />

			@if (currentInitial != null)
			{
				<InputNumber hidden class="form-control" @bind-Value="currentInitial.Initial_Id" />
				<div class="form-group mb-3">
					<label>ชื่อสาขา</label>
					<InputText class="form-control" @bind-Value="currentInitial.Initial_Name" />
					<ValidationMessage For="@(() => currentInitial.Initial_Name)" />
				</div>

			}
		</EditForm>
	</ChildContent>
</Modals>

@if (IsProcessing)
{
	<div class="position-absolute w-75 h-75 d-flex flex-column align-items-center bg-white justify-content-center">
		<div class="spinner">
			<div class="rect1"></div>
			<div class="rect2"></div>
			<div class="rect3"></div>
			<div class="rect4"></div>
			<div class="rect5"></div>
		</div>
	</div>
}
else
{
	<div class="card shadow border-0 mt-4">
		<div class="card-header bg-black bg-gradient ml-0 py-3">
			<div class="row">
				<div class="col-12 text-center">
					<h2 class="text-white py-2">ระบบจัดการข้อมูลคำนำหน้าชื่อ</h2>
				</div>
			</div>
		</div>
		<div class="card-body p-4">
			<div class="row pb-3">
				<div class="col-12 text-end">
					<button class="btn btn-lg btn-secondary" style="width:250px;" @onclick="() => ShowAddModal()">
						<i class="bi bi-plus-square"></i> เพิ่มข้อมูลคำนำหน้าชื่อ
					</button>
				</div>
			</div>

			<table class="table">
				<thead>
					<tr>
						<th>ชื่อคำนำหน้าชื่อ</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					@foreach (var b in initialList)
					{
						<tr>
	
							<td>@b.Initial_Name</td>
							<td>
								<button class="btn btn-sm btn-primary" @onclick="() => ShowEditModal(b)">แก้ไข</button>
								<button class="btn btn-sm btn-danger" @onclick="() => DeleteInnitail(b.Initial_Id)">ลบ</button>
							</td>

						</tr>
					}
				</tbody>
			</table>

		</div>
	</div>

}

@code {
	private List<Initial> initialList = new();
	private Initial initial = new();
	private bool IsProcessing { get; set; } = true;

	private Modals initialModal;
	private bool showModal = false;
	private Initial currentInitial = new();
	private bool isEditMode = false;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await LoadInitial();
			IsProcessing = false;
			StateHasChanged();
		}
	}

	private async Task LoadInitial()
	{
		initialList = await InitialService.GetInitials();
	}

	private void ShowAddModal()
	{
		currentInitial = new Initial();
		isEditMode = false;
		showModal = true;
		StateHasChanged();
	}

	private void ShowEditModal(Initial initial)
	{
		currentInitial = new Initial
			{
				Initial_Id = initial.Initial_Id,
				Initial_Name = initial.Initial_Name

			};
		isEditMode = true;
		showModal = true;
		StateHasChanged();
	}

	private void CloseModal()
	{
		showModal = false;
		StateHasChanged();
	}

	public async Task DeleteInnitail(int id)
	{
		bool confirmDelete = await JSRuntime.InvokeAsync<bool>("ShowSwal", "success", "คุณแน่ใจที่จะลบหรือไม่?");

		if (confirmDelete)
		{
			await InitialService.Delete(id);

			await JSRuntime.InvokeVoidAsync("showToastr", "success", "ลบสำเร็จ");
		}
		await LoadInitial();
	}

	private async Task HandleValidSubmit()
	{
		try
		{
			IsProcessing = true;
			StateHasChanged();

			if (isEditMode)
			{
				await InitialService.UpdateInitial(currentInitial);
				await JSRuntime.InvokeAsync<bool>("ShowSwal", "test", "อัพเดทสำเร็จ");
			}
			else
			{
				await InitialService.AddInitial(currentInitial);
				await JSRuntime.InvokeAsync<bool>("ShowSwal", "test", "เพิ่มสำเร็จ");
			}

			await LoadInitial();
			showModal = false;
		}
		catch (Exception ex)
		{
			await JSRuntime.InvokeVoidAsync("showToastr", "error", $"เกิดข้อผิดพลาด: {ex.Message}");
		}
		finally
		{
			IsProcessing = false;
			StateHasChanged();
		}

	}

}