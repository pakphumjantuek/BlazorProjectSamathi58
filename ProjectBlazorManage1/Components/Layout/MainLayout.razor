@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<MudThemeProvider />
<MudPopoverProvider />
<div class="page">
    <AuthorizeView Roles="@SD.Role_Admin">
        <div class="sidebar">
            <NavMenu />
        </div>
    </AuthorizeView>

    <main>
        @if (_navBarVisible && !_isAuthPage)
        {
            <NavBar></NavBar>
        }


        <article class="content px-4">
            @Body
        </article>

        @if (_navBarVisible && !_isAuthPage)
        {
            <Footer />
        }

    </main>

</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {     
        private bool _navBarVisible;
        private bool _isAuthPage;

        protected override async Task OnInitializedAsync()
        {
            _navBarVisible = await ShowNavBar();
            CheckIfAuthPage();
        }

        protected override async Task OnAfterRenderAsync(bool firstRender)
        {
            if (firstRender)
            {
                _navBarVisible = await ShowNavBar();
                CheckIfAuthPage();
                StateHasChanged();
            }
        }

        private async Task<bool> ShowNavBar()
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var authenticated = user.Identity is not null && user.Identity.IsAuthenticated;
            if (!authenticated || !user.IsInRole(SD.Role_Admin))
            {
                return true;
            }
            return false;
        }

        private void CheckIfAuthPage()
        {
            var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).ToLower();
            _isAuthPage = relativePath.Contains("login") || relativePath.Contains("register");
        }
}

